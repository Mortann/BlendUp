{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BlendUp",
  "version": "0.2.0",
  "identifier": "com.blendup.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BlendUp",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "windowClassname": "BlendUpMainWindowV020",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

