{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BlendUp",
  "version": "0.1.0",
  "identifier": "com.blendup.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BlendUp",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}

