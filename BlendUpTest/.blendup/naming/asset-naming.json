{
  "schemaVersion": 1,
  "kind": "asset_naming_rules",
  "pattern": "{prefix}_{name}_{index}",
  "prefixes": [
    "PROP",
    "ENV",
    "CHR",
    "MAT",
    "TEX",
    "UI",
    "FX"
  ],
  "blenderSuffixes": [
    "_MESH",
    "_COL",
    "_LOD0",
    "_LOD1",
    "_ARM",
    "_RIG",
    "_EMPTY",
    "_SOCKET"
  ],
  "forbiddenNameFragments": [
    "final",
    "new",
    "copy",
    "test"
  ]
}

