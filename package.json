{
  "name": "blendup",
  "version": "0.2.1",
  "private": true,
  "description": "BlendUp production workspace.",
  "type": "module",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm --workspace @blendup/desktop run dev",
    "build": "npm --workspace @blendup/desktop run build",
    "typecheck": "npm --workspace @blendup/desktop run typecheck",
    "test": "npm run typecheck && npm run test:explorer && npm run test:rust && npm run test:blender-core",
    "test:explorer": "npm --workspace @blendup/desktop run test:explorer",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "test:blender-core": "python -m unittest discover -s apps/blender-addon/tests -p test_*.py",
    "preview": "npm --workspace @blendup/desktop run preview",
    "tauri:dev": "npm --workspace @blendup/desktop run tauri:dev",
    "tauri:build": "npm --workspace @blendup/desktop run tauri:build",
    "release:check": "python scripts/package_release.py --check",
    "release:package": "python scripts/package_release.py"
  }
}
